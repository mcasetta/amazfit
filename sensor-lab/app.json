{
  "configVersion": "v3",
  "app": {
    "appId": 23476,
    "appName": "Sensor Lab",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "mcasetta",
    "description": "Live readings from the watch sensors - step 1 sensor exploration"
  },
  "permissions": [
    "data:user.hd.heart_rate",
    "device:os.barometer",
    "data:user.hd.body_temp",
    "device:os.geolocation",
    "device:os.compass",
    "data:user.hd.spo2",
    "device:os.accelerometer",
    "device:os.gyroscope",
    "data:user.hd.step",
    "data:user.hd.calorie",
    "data:user.hd.distance",
    "data:user.hd.stress"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/sensors"
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Sensor Lab"
    },
    "it-IT": {
      "appName": "Sensor Lab"
    }
  },
  "defaultLanguage": "en-US"
}
