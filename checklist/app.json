{
  "configVersion": "v3",
  "app": {
    "appId": 23480,
    "appName": "Checklist",
    "appType": "app",
    "version": {
      "code": 6,
      "name": "0.1.5"
    },
    "icon": "icon.png",
    "vender": "mcasetta",
    "description": "Lists pasted on the phone (Zepp app settings), checked off on the watch"
  },
  "permissions": [
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/list"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Checklist"
    },
    "it-IT": {
      "appName": "Checklist"
    }
  },
  "defaultLanguage": "en-US"
}
