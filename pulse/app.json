{
  "configVersion": "v3",
  "app": {
    "appId": 23477,
    "appName": "Pulse",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "mcasetta",
    "description": "Interval timer for stretching, planks, running repeats and any work/rest workout"
  },
  "permissions": [
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/detail",
            "page/edit",
            "page/run"
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Pulse"
    },
    "it-IT": {
      "appName": "Pulse"
    }
  },
  "defaultLanguage": "en-US"
}
